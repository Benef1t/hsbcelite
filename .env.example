# HSBC US Login Credentials
HSBC_USERNAME=your_username
HSBC_PASSWORD=your_password

# HSBC US base URL (default for US)
HSBC_BASE_URL=https://www.us.hsbc.com

# Google Sheets
GOOGLE_SHEETS_ID=your_google_sheet_id

# Path to Google service account credentials JSON
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# Schedule (cron-like, runs on your Mac)
# How many minutes between checks (default: 720 = 12 hours = twice daily)
CHECK_INTERVAL_MINUTES=720

# Browser settings
# Set to false for first run to watch the browser and debug
HEADLESS=true
