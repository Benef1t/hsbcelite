<!-- Mac LaunchAgent for running HSBC Points Tracker daily at 7:00 AM -->
<!-- Copy this to ~/Library/LaunchAgents/ -->
<!-- Then: launchctl load ~/Library/LaunchAgents/com.hsbc.points-tracker.plist -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hsbc.points-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/bruce/claudeSpace/hsbcelite/.venv/bin/python</string>
        <string>-m</string>
        <string>src.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/bruce/claudeSpace/hsbcelite</string>

    <!-- Run at 7:00 AM daily -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/bruce/claudeSpace/hsbcelite/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bruce/claudeSpace/hsbcelite/launchd_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
